{
  "name": "@gorav/openai-oauth",
  "description": "OpenAI OAuth provider for the Vercel AI SDK",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:package": "node scripts/validate-package.mjs",
    "validate:consumer:live": "pnpm build && node scripts/validate-package.mjs --live",
    "release-check": "pnpm typecheck && pnpm test && pnpm build && pnpm validate:package",
    "validate:live": "pnpm build && node scripts/validate-live-v0.1.mjs",
    "validate:live:v0.4": "pnpm build && node scripts/validate-live-v0.4.mjs",
    "validate:live:v0.5": "pnpm build && node scripts/validate-live-v0.5.mjs"
  },
  "keywords": [
    "ai-sdk",
    "openai",
    "oauth",
    "chatgpt"
  ],
  "author": "Gorav Jhabakh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goravjhabakh/openai-oauth.git"
  },
  "homepage": "https://github.com/goravjhabakh/openai-oauth#readme",
  "bugs": {
    "url": "https://github.com/goravjhabakh/openai-oauth/issues"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.28",
    "@ai-sdk/provider-utils": "^5.0.61",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ai": "^7.0.142",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  }
}
